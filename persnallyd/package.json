{
  "name": "persnally",
  "version": "3.2.0",
  "license": "FSL-1.1-MIT",
  "description": "A model of you, built from your own AI history, on your machine. Every AI you use reads it. So every AI finally knows you.",
  "type": "module",
  "bin": {
    "persnally": "build/src/cli.js",
    "persnallyd": "build/src/cli.js",
    "persnally-mcp": "build/src/mcp/index.js"
  },
  "files": [
    "build/src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/check-node.mjs && tsc && npm run build:ui && node scripts/copy-html.mjs && node scripts/mark-bins-executable.mjs",
    "lint": "eslint .",
    "test": "npm run build && node --test build/test/*.test.js && node test-mcp-e2e.mjs",
    "serve": "npm run build && node build/src/cli.js serve",
    "prepublishOnly": "node scripts/check-node.mjs && node -e \"const fs=require('fs');fs.copyFileSync('../README.md','README.md');fs.copyFileSync('../LICENSE','LICENSE');fs.copyFileSync('../CHANGELOG.md','CHANGELOG.md')\" && npm test",
    "build:ui": "tsc -p dashboard-ui && vite build dashboard-ui",
    "dev:ui": "vite dashboard-ui"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^2.0.5",
      "hono": "^4.12.34",
      "ip-address": "^10.3.1",
      "express": {
        "body-parser": "^2.2.3"
      },
      "ajv": {
        "fast-uri": "^3.1.5"
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "node-gyp": "^13.0.2",
    "preact": "^10.29.8",
    "simple-icons": "^16.29.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "context-engine",
    "personal-context",
    "local-first",
    "ai",
    "claude",
    "interest-graph"
  ],
  "author": "Persnally",
  "homepage": "https://persnally.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/persnally/persnally.git"
  },
  "bugs": {
    "url": "https://github.com/persnally/persnally/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
